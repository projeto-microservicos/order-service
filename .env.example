# Local development only. Run python scripts/init-env.py.
DB_USER=store
DB_NAME=store
DB_PASSWORD=GENERATE_ME
HTTP_PORT=8082
PRODUCT_URL=http://product:8080
EXCHANGE_URL=http://exchange:8080
CACHE_ENABLED=true
CACHE_TTL=5m
MESSAGING_ENABLED=true
RABBITMQ_PASSWORD=GENERATE_ME
GRAFANA_PASSWORD=GENERATE_ME
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Optional OAuth2 resource server. The token subject must be the account UUID.
JWT_ENABLED=false
JWT_ISSUER_URI=
JWT_AUDIENCE=order-service
# Use a Stripe test key for local development. Never commit a real key.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
