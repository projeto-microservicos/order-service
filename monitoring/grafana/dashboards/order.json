{
  "uid": "order-service",
  "title": "Order service",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Requests / second", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{application=\"order\"}[5m]))"}]},
    {"id": 2, "type": "timeseries", "title": "p95 latency (seconds)", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"order\"}[5m])))"}]},
    {"id": 3, "type": "timeseries", "title": "5xx responses / second", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{application=\"order\",status=~\"5..\"}[5m]))"}]},
    {"id": 4, "type": "timeseries", "title": "Database connections awaiting a slot", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "hikaricp_connections_pending{application=\"order\"}"}]},
    {"id": 5, "type": "timeseries", "title": "Cache hits / misses / errors per second", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (result) (rate(orders_cache_requests_total{application=\"order\"}[5m]))"}, {"refId": "B", "expr": "sum(rate(orders_cache_errors_total{application=\"order\"}[5m]))"}]},
    {"id": 6, "type": "timeseries", "title": "Published events / retries per second", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (result) (rate(orders_outbox_deliveries_total{application=\"order\"}[5m]))"}]}
  ]
}
